{
  "name": "campusbridge-alumni-management",
  "version": "1.0.0",
  "description": "Simple MERN CRUD project for alumni management.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "server": "nodemon server/index.js",
    "client": "vite client --host 127.0.0.1",
    "build": "vite build client",
    "preview": "vite preview client --host 127.0.0.1",
    "start": "node server/index.js",
    "seed": "node server/scripts/seedSurana.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "nodemon": "^3.1.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7"
  }
}
